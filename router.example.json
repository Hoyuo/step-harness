{
  "routes": [
    {
      "name": "code complete",
      "when": "^/?cc\\b",
      "program": { "task": "코드 컴플리트 게이트를 통과시킨다", "done_when": ["code-complete"] }
    },
    {
      "name": "fix with tests",
      "when": "^fix:\\s*(.+)",
      "program": { "task": "$1 을(를) 고치고 테스트를 통과시킨다", "done_when": ["unit-test"] }
    }
  ]
}
